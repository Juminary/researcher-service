// ============================================================================
// Prisma + SQLite 数据模型（wayfinder #310 草案 + #311/#328 扩展 · issue #333 落地）
//
// 来源：docs/research/310-prisma-schema-draft.prisma（已过 prisma validate）。
// 本期（M0/M1）扩展：User 新增 mustChangePassword / maxContainers（#311 C1 + #319 /me 要求，
// 310 草案 User 缺这两列）。其余 5 实体原样平移（容器/WIKI/桥接是后续切片，但 schema 一次落地）。
//
// 平移映射见 310 草案头部注释。目标 Prisma 7：generator=prisma-client（TS）+ driver adapter
// （@prisma/adapter-better-sqlite3），datasource 仅 provider、url 在 prisma.config.ts / PrismaClient。
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// User —— 账号实体（管理员 + 普通用户双角色）
//
// #311/#328 扩展（相对 310 草案）：
//   - mustChangePassword  bootstrap/重置/新建账号置 true（C1 强制改密）
//   - maxContainers       per-user 配额，admin 可改，超额拒 20042
// ---------------------------------------------------------------------------
enum Role {
  admin
  user
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique // 登录名（Django UnicodeUsernameValidator 同语义）
  email              String?  @unique // 可空；OIDC 首登常以此为主键对齐
  passwordHash       String?  // bcrypt 散列；纯 OIDC 账号可空 → 应用层禁空密码登录
  role               Role     @default(user)
  isActive           Boolean  @default(true) // 平移 Django is_active（软禁用，不删行）
  mustChangePassword Boolean  @default(false) // #311 C1：首登/重置后强制改密
  maxContainers      Int      @default(3) // #311 配额；默认值经 env DEFAULT_MAX_CONTAINERS 在应用层覆盖
  // --- #771（#747 B 节 · 731 §3.3 / 729 §3.5）---
  maxConcurrentRuns Int           @default(2) // per-user 在飞 run 配额（story 55；超限 40043）
  approvalMode      ApprovalMode  @default(standard) // 谨慎模式：cautious 下灰区强制升级人工（story 35）

  // --- OAuth2 预留（#311 O1 仅骨架；此处仅留形状）---
  oidcSubject String? // OIDC sub claim
  oidcIssuer  String? // OIDC issuer
  @@unique([oidcIssuer, oidcSubject]) // 同 issuer 下 sub 唯一（双可空时 SQLite 视为 distinct）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  containers      Container[]
  refreshTokens   RefreshToken[]
  textTraceLogs   TextTraceLog[]
  figures         Figure[]
  // --- #771（#747 B 节）：LangGraph 新表关系 ---
  sessions         Session[]
  modelProviders   ModelProvider[] // 归属上移：provider 配置挂用户（731 §3.2）
  attachments      Attachment[]
  pluginEnablements PluginEnablement[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// ApprovalMode —— 谨慎模式开关（#729 §3.5）：standard 常规三层漏斗 / cautious 灰区强制人工升级。
// ---------------------------------------------------------------------------
enum ApprovalMode {
  standard
  cautious
}

// ---------------------------------------------------------------------------
// TextTraceLog - generated-content provenance/audit records.
//
// Each completed assistant generation gets one row that links the final output
// to the triggering user, client IP, container/session/run, and a stable hash.
// The text itself is not modified; this supports the "content message" and
// "digital signature/hash" screenshots in the provenance sample document.
// ---------------------------------------------------------------------------
enum TextTraceStatus {
  success
  failed
}

model TextTraceLog {
  id            String          @id @default(cuid())
  traceId       String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  username      String
  ipAddress     String
  containerName String?
  sessionKey    String?
  runId         String?
  inputText     String          @default("")
  outputText    String          @default("")
  outputHash    String          @default("")
  status        TextTraceStatus @default(success)
  createdAt     DateTime        @default(now())

  @@index([userId])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([status])
  @@map("text_trace_logs")
}

// ---------------------------------------------------------------------------
// RefreshToken —— refresh token 持久化（重写新增；现状 simplejwt 无状态、无表）
//
//   - tokenHash         存 sha256 散列不落明文（零信任）
//   - revokedAt         旋转或撤销时置位；旧 token 重放即判无效
//   - replacedByTokenId 旋转链：新 token 指回被它替换的旧 token（reuse 检测）
// ---------------------------------------------------------------------------
model RefreshToken {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  tokenHash         String   @unique // 散列唯一索引：查找 + 防重
  expiresAt         DateTime
  revokedAt         DateTime? // null=有效；置位=已撤销/已旋转
  replacedByTokenId String? // 旋转链指针（R1 reuse 检测）

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Container —— 一个 OpenClaw 容器实例的记账行（平移 containers.Instance，+ownerId 隔离）
//
// name 全局唯一（#312 定夺，非按用户）。本期 M1 仅用于 GET /users 计 containerCount，
// 容器生命周期由 M2 实现；schema 一次落地。
// ---------------------------------------------------------------------------
enum ContainerStatus {
  creating
  running
  stopped
  removing
  error
  // #699 容器升级编排（spec §2.2）：upgrading = 六步升级在飞（删/重复触发被拒）；
  // upgrade_failed = 连续失败进入终态（仅可删除重建）。SQLite TEXT 无 CHECK，纯 app 层 + prisma generate。
  upgrading
  upgrade_failed
}

model Container {
  id   String @id @default(cuid())
  name String @unique // DNS-label：^[a-z][a-z0-9-]{2,29}$（应用层校验）
  port Int    @unique

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  token          String // 应用层加密后的密文
  tokenEncrypted Boolean @default(false)
  homeDir        String // bind-mount 宿主路径 instances/<id>/home（代系绑定 #360）
  containerId    String @default("") // run 前未知；空串而非 NULL
  status         ContainerStatus @default(creating)
  image          String
  // #699 升级编排连续失败计数（spec §2.2）：可重试失败 +1，成功清零；≥3 → upgrade_failed 终态。
  upgradeAttempts Int @default(0)
  leaseExpiresAt DateTime? // null=无保护

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pairing Pairing?

  @@index([ownerId])
  @@map("containers")
}

// ---------------------------------------------------------------------------
// Pairing —— 设备配对记账行（平移 chat.Pairing，一对一 Cascade）。M4 实现。
// ---------------------------------------------------------------------------
enum PairingStatus {
  unpaired
  pending
  paired
  error
}

model Pairing {
  id          String    @id @default(cuid())
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  containerId String    @unique // 一对一

  deviceId                String @default("")
  publicKeyPem            String @default("")
  privateKeyPem           String @default("") // 密文
  privateKeyPemEncrypted  Boolean @default(false)
  deviceToken             String @default("") // @deprecated 方向 A：deviceToken 回浏览器 localStorage（chat/deviceAuth.ts），此列不再读写（保留避免生产 DROP COLUMN 迁移）
  deviceTokenEncrypted    Boolean @default(false) // @deprecated 同上
  scopesJson              String @default("[]")
  pairingRequestId        String @default("")
  status                  PairingStatus @default(unpaired)
  attemptVersion          Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("pairings")
}

// ---------------------------------------------------------------------------
// LcProvider —— LangChain provider 二值白名单（#771 / 731 §2.1）：
// 与旧 wire 枚举 1:1（openai-completions→openai / anthropic-messages→anthropic，映射收敛于
// models/values.ts）；OpenAI 兼容端点（vLLM/MiniMax 等）统一走 openai + baseUrl。
// ---------------------------------------------------------------------------
enum LcProvider {
  openai
  anthropic
}

// ---------------------------------------------------------------------------
// ModelProvider —— 一个用户的一个 model provider 行（#771 改造，731 §3.2 逐字段 DDL）。
//
// 归属上移：containerId → ownerId（#731 §1.3——新架构「用户」才是配置主体，多容器共享同
// 一 LLM 配置面）；唯一键随之 (ownerId, providerId)。旧 wire 枚举 api（openai-completions /
// anthropic-messages）由 lcProvider 二值取代（731 §3.2「二选一保留」取新列，wire 契约经
// values.ts 映射保持不变）；apiKeyEnvId → credentialEnvId（过渡期引用 LLM_API_KEY），
// credentialCipher 预留 P1 per-user key（AES 密文，对齐 Container.token 先例）。
//
// 注意：#771 验收钉死「旧表（ModelProvider 旧形状）本票不动，留待 T0 清退」——存量库中的
// 旧形状 model_providers 行不由本票迁移；fresh 库（init.sql）即本新形状。
// ---------------------------------------------------------------------------
model ModelProvider {
  id          String    @id @default(cuid())
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String // users.id（归属上移，731 §3.2）

  providerId  String // openclaw.json models.providers 的 map key；DNS-label（应用层校验）
  lcProvider  LcProvider // LangChain provider 二值白名单（openai/anthropic）
  baseUrl     String // 完整 URL；origin 须命中 provider_endpoints 白名单（40042）
  credentialEnvId   String?  // 过渡期：引用 LLM_API_KEY（对齐旧 apiKeyEnvId；P1 后退役）
  credentialCipher  String?  // P1 扩展：per-user key，AES 密文（预留，本期不读写）
  authHeader  Boolean   @default(true)
  modelsJson  String // 模型条目数组 JSON 文本（id/name/reasoning/input/cost/contextWindow/maxTokens）

  createdAt DateTime @default(now())

  @@unique([ownerId, providerId])
  @@map("model_providers")
}

// ---------------------------------------------------------------------------
// Figure —— AutoFigure 用户可见领域资源（docs/autofigure/spec.md §1 · grilling §2）。
// Figure 1:1 GenerationJob（两表职责分离：Figure 承载领域资源语义，Job 承载执行状态）。
// ownerId 只由认证的 researcher-service 身份（JWT）派生，永不来自客户端提交（grilling §3）。
// V1 无 Figure 删除（owner 与 admin 均无），本模型不含删除/软删语义。
// ---------------------------------------------------------------------------
model Figure {
  id      String @id @default(cuid())
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String
  prompt  String // 用户可见的 text-to-figure 生成输入（zod 校验后入库）

  // T02 幂等（docs/autofigure/tickets/T02-idempotent-figure-creation.md · grilling §17）：
  // Idempotency-Key 按 (ownerId, idempotencyKey) 唯一（唯一索引是并发重复创建去重的最终仲裁）。
  // nullable 容 T02 前既有行（升级脚本走 ALTER TABLE ADD COLUMN，无 NOT NULL 默认可给）；
  // 应用层恒非空（Idempotency-Key 请求头必带，缺 → 90002）。
  idempotencyKey String?

  // T06 产物持久化（docs/autofigure/tickets/T06-artifact-persistence-png.md · grilling §6）：
  // xml（文本）+ png（SQLite BLOB）+ evaluation（文本 JSON）仅在 Job 提交 succeeded 终态时
  // 一并原子写入（runner persistSucceededWithArtifacts，T04 围栏保证 failed 后迟到成功不写）；
  // queued/running/failed 恒 null。png 用 Prisma Bytes（= Uint8Array）。evaluation 是 Port 边界
  // 已归一化的非敏感 JSON 载荷（T07 适配器负责从 raw 执行输出归一化；本行绝不落 raw provider/
  // Python 响应/栈/凭证）。list/detail 公开投影不含本三列（下载契约：仅 owner 且仅 succeeded）。
  xml        String? // 生成产物 XML（文本）
  png        Bytes? // 生成产物 PNG（SQLite BLOB）
  evaluation String? // 生成产物 evaluation（文本 JSON）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job GenerationJob? // 1:1（figureId @unique）

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId])
  @@map("figures")
}

// ---------------------------------------------------------------------------
// GenerationJob —— AutoFigure 一次后台执行的持久化记录（docs/autofigure/spec.md §1-2）。
// 本表只承载执行状态契约；状态机转换 / errorMessage 填充由 T03 runner 实现（T01 只建列）。
// 状态值集（queued/running/succeeded/failed）来自 spec §2 已批准状态机，T01 仅落默认 queued。
// ---------------------------------------------------------------------------
enum GenerationJobStatus {
  queued
  running
  succeeded
  failed
}

model GenerationJob {
  id      String   @id @default(cuid())
  figure  Figure   @relation(fields: [figureId], references: [id], onDelete: Cascade)
  figureId String @unique // 1:1 Figure ↔ Job（grilling §2：非为未来 1:N 预留）
  status       GenerationJobStatus @default(queued)
  errorMessage String? // 失败原因（非敏感）；runner 填充，T01 恒 null
  startedAt    DateTime? // T03：原子领取（queued→running）时刻置位，恒在 running 期间非空
  finishedAt   DateTime? // T03：终态（succeeded|failed）写入时刻置位；running/queued 恒 null
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("generation_jobs")
}

// ===========================================================================
// #771（#747·01）LangGraph agent runtime 新表地基 —— 会话历史域 + 审计域 + 配置域
//
// 逐字段依据：#747 B 节表 + 731/729/752/766/768/770 resolution。commands/skills 官方内容
// 目录不建表（#758 Q1/Q2/Q6 钉死 always-on 无表）。旧表（Pairing / ModelProvider 旧形状）
// 本票不动，留待 T0 清退（#801）。
// ===========================================================================

// ---------------------------------------------------------------------------
// Session —— 会话行（#727）：id = LangGraph thread_id（cuid，不编码），会话扁平挂用户
// （容器维度退役，story 4）。rewind/分支 = 换 activeCheckpointId 指针，消息行永不物理删。
// ---------------------------------------------------------------------------
model Session {
  id   String @id @default(cuid()) // = LangGraph thread_id（cuid，不编码 —— #727）
  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  // 绑定的会话沙箱 docker 容器 id（researcher-sandbox-<sessionId>，#747 E 节）。
  // 无 FK：沙箱注册表面貌归 #784 双容器 orchestrator，legacy containers 表形状
  // （port/token/homeDir 必填）与沙箱规格（无宿主端口/token，端口池随 legacy 退役废除）矛盾；
  // 「删容器级联 sessions」由 orchestrator 应用层联动（#727 retention，deleteThread 同款）。
  containerId String
  title       String @default("") // 自动生成可修改（story 5）；空串 = 未命名

  // fork 溯源（#727）：parentSessionKey = 源 session id；forkSourceJson = 切点 checkpoint 等。
  parentSessionKey String?
  forkSourceJson   String?

  // rewind/分支指针（#727）：指向 checkpoints 行（threadId = 本行 id）；换指针不删消息行，
  // 旧分支自然保留（checkpoint 树即分支真相源）。
  activeCheckpointId String?

  // 文件 rewind 水位（#782 · D8）：锚点时刻的 journal 最大 seq。逆放集 = seq > 水位 ∧
  // 行未处置（fileRevertedAt null）；崩溃续放判据（残集非空 → 续放，逆放幂等）。
  // scope=chat（只回对话文件保持现状）= 水位推进至当前 max（处置面永久跳过）。
  fileJournalAnchorSeq Int?

  // #787: /model is a session preference, applied at the next run snapshot.
  preferredModelJson String?

  // #770：branch-switch 机制取消后，「先 fork 再回退」的被放弃原路线软删除存档
  // （delete 标记、映射层过滤——产品面不可读、行不物理删，retention/refcount GC 回收对象）。
  archivedAt DateTime?
  // Teammate threads use the same checkpoint store but stay out of the user's top-level session list.
  isTeammate Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    SessionMessage[]
  checkpoints Checkpoint[]
  checkpointWrites CheckpointWrite[]
  attachments Attachment[]
  fileJournal FileJournal[]
  parentTeammates Teammate[] @relation("TeammateParent")
  teammateThread Teammate? @relation("TeammateThread")
  teammateMessages TeammateMailboxMessage[]
  teammateMailboxParentWaits TeammateMailboxWait[] @relation("MailboxWaitParent")
  teammateMailboxThreadWait TeammateMailboxWait? @relation("MailboxWaitThread")

  @@index([ownerId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Teammate —— a named agent thread owned by a parent session (#786).
// A teammate has its own Session row so LangGraph checkpoints and approvals remain isolated;
// that row is hidden from the top-level session list and remains archived after close.
// ---------------------------------------------------------------------------
model Teammate {
  id              String   @id @default(cuid())
  parentSession   Session  @relation("TeammateParent", fields: [parentSessionId], references: [id], onDelete: Cascade)
  parentSessionId String
  thread           Session  @relation("TeammateThread", fields: [threadId], references: [id], onDelete: Cascade)
  threadId         String @unique
  name             String
  task             String
  status           String   @default("requested")
  // #790（#747·20 · G 节三通道②）：teammate 类别——generic 缺省 / wiki-update = 治理生成
  // teammate（RunService 装配落地副本 backend + 生命周期工具 + 驱动提示；拓扑可由本列推导）。
  kind             String   @default("generic")
  modelProviderId  String?
  spawnedAtCheckpointId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  archivedAt       DateTime?

  messages TeammateMailboxMessage[]
  waits    TeammateMailboxWait[]

  @@unique([parentSessionId, name])
  @@index([parentSessionId, status])
  @@map("teammates")
}

// TeammateMailboxMessage —— durable point-to-point mail and request history (#786).
// recipientTeammateId=null addresses the leader. Invalidated messages remain auditable after rewind.
model TeammateMailboxMessage {
  id              String   @id @default(cuid())
  parentSession   Session  @relation(fields: [parentSessionId], references: [id], onDelete: Cascade)
  parentSessionId String
  senderTeammate  Teammate? @relation(fields: [senderTeammateId], references: [id], onDelete: SetNull)
  senderTeammateId String?
  recipientTeammateId String?
  kind            String   @default("message")
  content         String
  createdAt       DateTime @default(now())
  readAt          DateTime?
  invalidatedAt   DateTime?
  expiresAt       DateTime?

  @@index([parentSessionId, recipientTeammateId, createdAt])
  @@index([recipientTeammateId, readAt, invalidatedAt])
  @@map("teammate_mailbox_messages")
}

model TeammateMailboxWait {
  waitId                 String   @id
  parentSession          Session  @relation("MailboxWaitParent", fields: [parentSessionId], references: [id], onDelete: Cascade)
  parentSessionId        String
  thread                 Session  @relation("MailboxWaitThread", fields: [threadId], references: [id], onDelete: Cascade)
  threadId               String   @unique
  recipientTeammate      Teammate? @relation(fields: [recipientTeammateId], references: [id], onDelete: Cascade)
  recipientTeammateId    String?
  createdAt              DateTime @default(now())

  @@index([parentSessionId, recipientTeammateId])
  @@map("teammate_mailbox_waits")
}

// ---------------------------------------------------------------------------
// SessionMessage —— 消息投影行，产品读源（#727）：每 turn 聚合行（非 token 级——token 事件
// 即焚不落盘）。rewind/切换只动 Session 指针，本表行永不物理删（仅删会话级联清）。
// ---------------------------------------------------------------------------
model SessionMessage {
  id       String  @id @default(cuid())
  session  Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  turn    Int    // 轮次序号（会话内单调，读路径排序键之一）
  role    String // user / assistant / system / tool …（值集应用层约定；D9 媒体方向由本列派生）
  content String @default("")

  // 客户端幂等 key（story 7 · #747 C 节 32-hex）：仅 user 行携带（POST /messages 落行时盖印）。
  // (sessionId, clientKey) 唯一 = 断网重发不重复入列的约束面（并发同 key 单落走 P2002 兜底
  // 重查，bootstrap 先例）；assistant/system 行恒 NULL——SQLite UNIQUE 多 NULL 视为 distinct，
  // 不参与幂等域。
  clientKey String?

  // attachmentsJson v1 聚合（schema 版本化，#726/#768）：
  // {v:1, thinking?, tools?[{toolCallId,name,input≤1k,result≤1k,state,durationMs,rejection?,details?≤4KB}],
  //  approval?, compaction?, media?:MediaRef[]}
  // 本票（#778）产出子集：{v:1, thinking?, tools?[{toolCallId,name,input,state,durationMs?,
  // details?,truncated?}]}——C 节 result 概念由 RunProjector details 承载（#777 事件目录
  // tool.end 无独立 result 字段，4KB 截断）；rejection/approval/compaction/media 归 #783
  // 审批漏斗及后续票（v1 契约全景见 serializeAttachments 演进）。
  attachmentsJson String @default("{\"v\":1}")

  // 用户消息锚点 = rewind 目标 checkpoint（story 16；换 activeCheckpointId 时定位）。
  // user 行：本票暂 NULL（attachment 上传 #780 时落值）；assistant 行：run 终态 checkpoint
  // 锚点（issue #778 点名——recordTurn 注入缝从 RunService StateSnapshot 取）。
  anchorCheckpointId String?

  // #770 rewind 软删存档：被放弃原路线的行打标记（映射层过滤——投影 GET 不读；行不物理删，
  // retention 回收对象）。fork 复制只拷活跃行，归档行不随 fork。
  archivedAt DateTime?

  createdAt DateTime @default(now())

  attachments Attachment[] // 挂载于本消息的附件（用户附件 + agent→用户媒体同表，D9）

  @@index([sessionId, turn])
  @@unique([sessionId, clientKey])
  @@map("session_messages")
}

// ---------------------------------------------------------------------------
// Checkpoint / CheckpointWrite —— LangGraph 机制数据（#727；自定义 PrismaCheckpointSaver
// 五方法 put/putWrites/getTuple/list/deleteThread 的落点，#774 实现）。不暴露产品读。
// 形状对齐 LangGraph checkpoint 存储惯例（thread_id / checkpoint_ns / checkpoint_id 三元组）。
// ---------------------------------------------------------------------------
model Checkpoint {
  session    Session @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId   String // = Session.id（FK 级联：删会话清机制数据）
  checkpointNs       String @default("") // 子图命名空间
  checkpointId       String
  parentCheckpointId String? // checkpoint 树 = parent 链（分支真相源）
  type       String // LangGraph serializer type（如 "json"）
  blob       Bytes // 序列化 state（LangGraph dumpsTyped 字节；serde 默认 JSON —— #727）
  metadataJson String @default("{}")
  // #770 rewind 软删：被放弃原路线独有的 checkpoint 行打标记（retention/refcount GC 回收
  // 对象；机制面 LangGraph 不滤——activeCheckpointId 指针保证续跑永不触达归档分支）。
  archivedAt DateTime?
  createdAt  DateTime @default(now())

  @@id([threadId, checkpointNs, checkpointId])
  @@index([threadId, checkpointNs])
  @@map("checkpoints")
}

model CheckpointWrite {
  session  Session @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId String
  checkpointNs String @default("")
  checkpointId String // 目标 checkpoint（Loose 引用：LangGraph pending writes 语义，不建 FK）
  taskId   String
  idx      Int
  channel  String
  type     String
  blob     Bytes // pending write 序列化字节

  @@id([threadId, checkpointNs, checkpointId, taskId, idx])
  @@index([threadId, checkpointNs])
  @@map("checkpoint_writes")
}

// ---------------------------------------------------------------------------
// MemoryItem —— 跨会话长期记忆（BaseStore V1，#727）：PrismaMemoryStore 五方法
// get/put/delete/search/listNamespaces 落点（#774）。V1 无 embedding，前缀检索。
// 归属经 namespace 前缀（per-user）派生——刻意不建 user FK（#727：memory 跟 user 不级联）。
// createdAt（#774 补）：BaseStore Item 契约必填字段（put 时首记，跨会话记忆需知记忆成形时刻）。
// ---------------------------------------------------------------------------
model MemoryItem {
  namespace String // per-user 前缀（如 "user-<ownerId>"）
  key       String
  valueJson String
  createdAt DateTime @default(now()) // #774：Item.createdAt 契约（首写时刻，put 覆盖不刷新）
  updatedAt DateTime @updatedAt

  @@id([namespace, key]) // 复合主键左前缀即 namespace 索引（前缀检索走它）
  @@map("memory_items")
}

// ---------------------------------------------------------------------------
// ToolApprovalLog —— 审批三层漏斗全量审计（ADR 0015，729 §4.1 Prisma DDL 原文）：
// 规则/judge/人工三层同步写；judge 输入存 hash 不存全文；userId 冗余（无 FK）跟 user 永久。
// ---------------------------------------------------------------------------
enum ToolApprovalLayer {
  rule
  judge
  human
}

enum ToolApprovalDecision {
  allow
  deny
}

model ToolApprovalLog {
  id      String @id @default(cuid())
  traceId String // 弱关联 text_trace_logs.traceId（#727 双域接缝）
  runId   String
  userId  String // 冗余：审计快照跟 user 永久，不随容器/会话删（729 DDL 原文无 FK）
  layer   ToolApprovalLayer
  decision ToolApprovalDecision
  toolName String
  toolCall String // 规范化参数 JSON 快照
  policyClass String? // judge reject 的政策类（列拒四类之一）
  reason      String? // judge 理由 / 人工拒绝理由（用户可见）
  judgeInputHash String? // judge 输入快照 hash——不存全文，控体积
  latencyMs   Int? // judge 判定耗时（成本面，admin 可见）
  judgeTokens Int? // 输入+输出 token 成本（admin 可见）
  createdAt   DateTime @default(now())

  @@index([traceId])
  @@index([userId, createdAt])
  @@map("tool_approval_logs")
}

// ---------------------------------------------------------------------------
// ProviderEndpoint —— 端点白名单（731 §3.1 逐字段 DDL，admin 管理，面板级）：
// origin 精确匹配（scheme+host+port 唯一），禁路径/子域通配（防 attacker.example.com 绕过）。
// 注意：SQLite UNIQUE 含 NULL port 不判重（NULL≠NULL）——应用层先查后建兜底（#775）。
// createdBy 记审计归属（731 DDL 无 FK 约束 → 不加；用户软删不物理删行）。
// ---------------------------------------------------------------------------
model ProviderEndpoint {
  id        String   @id @default(cuid())
  scheme    String // 'https'（生产仅 https；'http' 限 dev）
  host      String // 精确 host
  port      Int? // NULL = 默认端口
  note      String @default("")
  createdBy String // users.id
  createdAt DateTime @default(now())

  @@unique([scheme, host, port])
  @@map("provider_endpoints")
}

// ---------------------------------------------------------------------------
// ConfigMeta —— 单行配置版本计数器（731 §3.3）：provider/endpoint CRUD 同事务 +1 =
// 热生效信号（runner run 启动读版本判等，不等才重载快照）。id 恒 = 1（CHECK 约束 Prisma
// DSL 不可表达 → 应用层不变量）；迁移脚本 INSERT OR IGNORE 种子首行。
// ---------------------------------------------------------------------------
model ConfigMeta {
  id      Int @id @default(1) // 单行：id 恒 = 1
  version Int @default(1)

  @@map("config_meta")
}

// ---------------------------------------------------------------------------
// LlmUsageRecord —— LLM usage 全量采数（#775 · #747 F 节 / story 57 成本核算数据源）。
// 行 = 一次 LLM 调用的 usage_metadata 落账（runner callback 采数，731 §3.2「记账真值改采
// usage_metadata」）；模型单价不入行（核算时 join modelsJson.cost——单价随配置版本可变，
// 行只存用量真值）。runId/sessionId 弱关联无 FK（审计快照跟 user 永久，不随 run/会话级联删，
// 对齐 TextTraceLog/ToolApprovalLog 纪律）；userId+username 冗余快照（改名不影响历史归属）。
// ---------------------------------------------------------------------------
model LlmUsageRecord {
  id        String  @id @default(cuid())
  runId     String // run 弱关联（无 FK）
  sessionId String? // 会话弱关联（独立 run 如 wiki 治理生成可无会话）

  userId   String // 冗余无 FK（tool_approval_logs 先例）
  username String // 冗余快照（user 改名不影响历史核算归属）

  providerId String // model_providers.providerId 弱引用
  lcProvider String // openai / anthropic（构造侧 provider 种类）
  model      String // 实际调用的 model id

  inputTokens      Int @default(0)
  outputTokens     Int @default(0)
  cacheReadTokens  Int @default(0) // usage_metadata.input_token_details.cache_read
  cacheWriteTokens Int @default(0) // usage_metadata.input_token_details.cache_creation

  createdAt DateTime @default(now())

  @@index([userId, createdAt]) // 核算查询：按用户 + 时间窗
  @@index([model, createdAt]) // 核算查询：按模型 + 时间窗（全局面）
  @@index([runId]) // per-run 对账下钻（#812 打捞；#777 接线后 per-run 核算）
  @@map("llm_usage_records")
}

// ---------------------------------------------------------------------------
// PluginEnablement —— per-user 插件启用位（752 §4.2）：复合主键 ownerId+pluginId；
// teammate 默认继承 owner 启用集 = per-run 快照。enabledAt 必填无默认（752 SQL 原文
// TEXT NOT NULL）——调用方显式置位。级联 users：面板 user 行级联先例（752 草图未钉级联语义）。
// ---------------------------------------------------------------------------
model PluginEnablement {
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String
  pluginId String
  enabled  Boolean @default(true)
  enabledAt DateTime

  @@id([ownerId, pluginId])
  @@map("plugin_enablements")
}

// ---------------------------------------------------------------------------
// Attachment —— 附件元数据（766 D1：字节在沙箱 /lab/uploads/<attachmentId>/<原始文件名>，
// 不进表）。id = attachmentId 雪花算法（时间有序，String 承载——64 位雪花超 int53）。
// agent→用户媒体与用户附件同表（方向由挂载消息 role 派生，不加列不分目录 —— D9）。
// fork 行全量复制不改 attachmentId（768 D7）→ 唯一域 = 会话内，主键复合 (sessionId, id)。
// ---------------------------------------------------------------------------
model Attachment {
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  id        String // attachmentId（雪花算法；fork 复制不改 → 会话内唯一）
  owner     User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  message   SessionMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // 可空：766 D5 时序——上传端点先建元数据行、消息行后由投影引用 attachmentId（G 节 D5/D9：
  // 两条建行路径都是附件行先于消息行）；回填后非空。rewind 随消息同进退。
  messageId String?

  fileName String // 原始文件名（字节路径组成部分）
  mimeType String
  size     Int // 字节数（单文件 ≤100MB——D6，int32 内）
  sha256   String // 内容校验（ingestion 节点校验落库）
  path     String // 沙箱内路径 /lab/uploads/<attachmentId>/<原始文件名>

  @@id([sessionId, id])
  @@index([ownerId])
  @@index([sessionId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// FileJournal —— 文件 rewind 机制数据（766 D8）：session-global 全序（行 = checkpointId
// 锚点 + 全局 seq + op/path/前后 sha256 + tombstoneKey + toolCallId 幂等键 + applied 标记）。
// 崩溃管线 journal-first：行先落 applied=false → apply → 置位（启动/restore 双路 roll-forward
// reconcile 补 apply）；重放 = 全局序逆放（rewind 恢复 /lab 至锚点时刻，exec 显式降级不入日志）。
// fork 继承：源行复制、fork 时点截断、seq 接续（768 D7）→ 唯一域均收窄会话级：
//   (sessionId, seq) 全局序唯一 · (sessionId, toolCallId) 幂等唯一（D8 原文「toolCallId UNIQUE」
//   经 D7 修订后限会话内——fork 复制行不改 toolCallId，全局唯一与 D7 冲突，后 resolve 者为准）。
// ---------------------------------------------------------------------------
model FileJournal {
  id       String  @id @default(cuid()) // 内部代理主键：fork 复制行后仍逐行可寻址（审计引用）
  session  Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  checkpointId String // op 生效锚点 checkpoint（rewind 预览/逆放定位）
  seq          Int // 会话内全局序（跨 thread——teammate 并发写同序；fork 时点截断、seq 接续）
  op           String // write / edit / delete（V1 值集应用层 + 测试锁定；rename 不在 V1 工具面）
  path         String // normalizeFilePath 后相对路径
  beforeSha256 String? // 前像 sha256（write 新文件无前像 → null）
  afterSha256  String? // 后像 sha256（delete 无后像 → null）
  tombstoneKey String? // 墓碑 key（daemon 侧 root 写 0700 隐藏目录；非墓碑行 null）
  toolCallId   String // 幂等键（journal-first 崩溃去重）
  // 打点所在 run（checkpointId 回填键：终态 recordTurn 按 runId 精确回填 anchorCheckpointId
  // ——'' 哨兵按会话回填会误伤并发 thread 的新 pending 行；runId 面无并发污染）。
  runId        String?
  applied      Boolean @default(false)
  // #770 rewind 软删：checkpointId 落在被放弃路线的行打标记（投影/继承面；fork 继承只拷活跃行）。
  archivedAt DateTime?
  // #782 行级处置标记：文件效果已处置（逆放完成 或 scope=chat 保持现状水位越过）。逆放集 =
  // seq > session.fileJournalAnchorSeq ∧ 本列 null；崩溃续放按同一判据（逆放幂等）。
  fileRevertedAt DateTime?

  @@unique([sessionId, seq])
  @@unique([sessionId, toolCallId])
  @@index([sessionId, checkpointId])
  @@map("file_journal")
}

// ---------------------------------------------------------------------------
// FileOverwriteLog —— teammate 并发写 write-after-write 覆盖审计（#785 · #747 E 节
// 「teammate 并发写互斥（#769 锁方案）」语义层）：取锁写 path 时存在已 applied 且上家
// writer ≠ 本 thread 的 file_journal 行 → 记一次（path/覆盖者/被覆盖者，不限时窗）。
// 观测面进审计域（D8 同纪律：静默失败不可接受），V1 覆盖合法、不做运行时提示。
// 弱关联无 FK（tool_approval_logs 审计快照先例——行跟审计域永久，不随会话删）；
// thread 身份存字符串快照（写者归属经 journal.checkpointId → checkpoints.threadId 解析
// 后落值，跨 fork/rewind 溯源不依赖 join）。
// ---------------------------------------------------------------------------
model FileOverwriteLog {
  id                  String @id @default(cuid())
  sessionId           String // 锁/journal 域会话（sandbox 所属 parent session）
  path                String // normalizeFilePath 后相对路径（lab/... | wiki/...，与锁 key 同约定）
  overwriterThreadId  String // 覆盖者 thread（本 thread；threadId = sessions.id 同构）
  overwrittenThreadId String // 被覆盖者 thread（journal 上家 writer）
  runId               String // 触发 run（弱关联）
  createdAt           DateTime @default(now())

  @@index([sessionId, path])
  @@index([createdAt])
  @@map("file_overwrite_logs")
}
